<core:FragmentDefinition 
  xmlns="sap.m" 
  xmlns:core="sap.ui.core">
  
  <VBox id="vbox3" class="kpiCard" alignItems="Stretch">
    
    <!-- Title -->
    <Text id="_IDGenText6" text="{/title}" class="kpiTitle"/>
    
    <!-- Period -->
    <Text id="_IDGenText7" text="{/period}" class="kpiSubtitle"/>
    
    <!-- Value and Percentage -->
    <HBox id="_IDGenHBox2" alignItems="End" class="sapUiSmallMarginBottom">
      <Text id="_IDGenText4" text="{/value}" class="kpiValue"/>
      <Text id="_IDGenText5" text="{/percentage}" class="kpiPercent"/>
    </HBox>
    
    <!-- Progress Bar -->
    <ProgressIndicator id="indi1" 
      percentValue="{/progress}" 
      displayValue="{/progress}%"
      state="{= ${/state} || 'None' }"
      width="100%"
      showValue="true"/>
      
  </VBox>
  
</core:FragmentDefinition>