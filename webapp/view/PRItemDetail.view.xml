<mvc:View
  controllerName="demodashboard.controller.PRItemDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:form="sap.ui.layout.form"
  xmlns:l="sap.ui.layout"
  displayBlock="true">

  <Page title="PR Item Detail">
    <headerContent>
      <Button icon="sap-icon://nav-back" press="onNavBack" type="Transparent" />
    </headerContent>

    <content>

    <HBox class="customHeaderBox" alignItems="Center" justifyContent="SpaceBetween">

  <!-- 🟩 Cột trái: ẢNH -->
  <VBox width="25%" alignItems="Center" class="headerImageContainer">
    <Image
      src="/images/tuanthanden.jpg"
      width="140px"
      height="140px"
      decorative="false"
      densityAware="false"
      class="headerProfileImage" />
  </VBox>

  <!-- 🟦 Cột phải: THÔNG TIN -->
  <VBox width="75%" class="headerInfoContainer">

    <Text text="{Txz01}" class="headerIntroText" />
    <Title text="{= 'PR ' + ${Banfn}}" level="H2" class="headerTitleText" />


    <HBox alignItems="Center" class="headerItemBox">
      <ObjectNumber
       unit="Item"
        number="{Bnfpo}"  
        emphasized="true"
        class="headerItemNumber" />
    </HBox>

  </VBox>
</HBox>



      <!-- GRID CHIA 2 CỘT -->
      <l:Grid
        id="detailGrid"
        defaultSpan="L6 M12 S12"
        hSpacing="2"
        vSpacing="1"
        class="sapUiMediumMarginBottom">

        <!-- ==== CỘT TRÁI: BASIC DATA ==== -->
        <Panel
  headerText="Basic Data"
  expandable="false"
  class="sapUiNoContentPadding sapUiSmallMarginBottom fioriSectionBox">

  <HBox
    class="sapUiSmallMarginTop sapUiSmallMarginBottom sapUiTinyMarginBegin sapUiTinyMarginEnd sapUiSmallScreenColumn"
    justifyContent="SpaceBetween">

    <!-- 🟩 CỘT TRÁI -->
    <VBox width="48%" class="sapUiSmallMarginEnd">
      <Label text="Item Category:" />
      <Text text="{path: 'Pstyp', formatter: '.getItemCategoryText'}" />

      <Label text="Requested By:" />
      <Text text="{Ernam}" />

      <Label text="Created By (Name):" />
      <Text text="{Ernam}" />

      <Label text="Material:" />
      <Link text="{Txz01}" press=".onMaterialPress" />

      <Label text="Short Text:" />
      <Text text="{Txz01}" />

      <Label text="Material Group:" />
      <Text text="{Matkl}" />
    </VBox>

    <!-- 🟦 CỘT PHẢI -->
    <VBox width="48%">
      <Label text="Valuation Price:" />
      <Text text="{Preis} {Waers}" />

      <Label text="Price Unit:" />
      <Text text="{Peinh} EA" />

      <Label text="Quantity Requested:" />
      <Text text="{Menge} {Meins}" />

      <Label text="Net Value:" />
      <Text text="{Netwr} {Waers}" />

      <Label text="Release Status:" />
      <Text text="{path: 'Frgkz', formatter: '.getReleaseStatus'}" />
    </VBox>

  </HBox>
</Panel>


        <!-- ==== CỘT PHẢI: DELIVERY ==== -->
        <form:SimpleForm
          layout="ResponsiveGridLayout"
          editable="false"
          title="Delivery"
          labelSpanL="5"
          labelSpanM="6"
          columnsL="1"
          columnsM="1">

          <Label text="Delivery Date" />
          <Text text="{path: 'Lfdat', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd/MM/yyyy'}}" />

          <Label text="Delivery Address" />
          <Text text="Việt Nam" />
        </form:SimpleForm>
      </l:Grid>


      
    </content>
  </Page>
</mvc:View>
