<mvc:View
  controllerName="demodashboard.controller.PRItemDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:form="sap.ui.layout.form"
  xmlns:l="sap.ui.layout"
  displayBlock="true">
<Page id="pagePRItemDetail" showHeader="true">
  
  <customHeader>
    <Bar>
      <contentLeft>
        <Button id="btnNavBack" icon="sap-icon://nav-back" press="onNavBack" type="Transparent" />
      </contentLeft>

      <contentMiddle>
        <Title text="📦 PR Item Detail" />
      </contentMiddle>
    </Bar>
  </customHeader>
    <content>
      <!-- 🧾 HEADER SECTION -->
      <HBox id="hboxHeader" class="customHeaderBox" alignItems="Center" justifyContent="SpaceBetween">
        <!-- 🟩 LEFT: IMAGE -->
        <VBox id="vboxHeaderImage" width="25%" alignItems="Center" class="headerImageContainer">
          <Image
            id="imgMaterial"
            src="images/doanhnhan.jpg"
            width="180px"
            height="180px"
            decorative="false"
            densityAware="false"
            class="headerProfileImage" />
        </VBox>
        <!-- 🟦 RIGHT: BASIC INFO -->
        <VBox id="vboxHeaderInfo" width="75%" class="headerInfoContainer">
          <Text id="txtHeaderDesc" text="{Txz01}" class="headerIntroText" />
          <Title id="txtHeaderTitle" text="{= 'PR ' + ${Banfn}}" level="H2" class="headerTitleText" />
          <HBox id="hboxItemNumber" alignItems="Center" class="headerItemBox">
            <ObjectNumber id="objItemNumber" unit="Item" number="{Bnfpo}" emphasized="true" class="headerItemNumber" />
          </HBox>
          <HBox
          class="sapUiTinyMarginTop"
          visible="{= ${ReasonId} ? true : false }">
          <Text text="Reason:" />
          <Text
            text="{path:'ReasonId', formatter:'.formatter.reasonText'}"
            class="sapUiTinyMarginBegin" />
        </HBox>

        </VBox>
      </HBox>
      <!-- GRID: TWO COLUMN LAYOUT -->
      <l:Grid
        id="gridDetail"
        defaultSpan="L6 M12 S12"
        hSpacing="2"
        vSpacing="1"
        class="sapUiMediumMarginBottom">
        <!-- ==== LEFT COLUMN: BASIC DATA ==== -->
        <Panel
          id="panelBasicData"
          headerText="Basic Data"
          expandable="false"
          class="sapUiNoContentPadding sapUiSmallMarginBottom fioriSectionBox">
          <HBox
            id="hboxBasicData"
            class="sapUiSmallMarginTop sapUiSmallMarginBottom sapUiTinyMarginBegin sapUiTinyMarginEnd sapUiSmallScreenColumn"
            justifyContent="SpaceBetween">
            <!-- LEFT BOX -->
            <VBox id="vboxBasicLeft" width="48%" class="sapUiSmallMarginEnd">
              <Label text="Item Category:" />
              <Text text="{path: 'Pstyp', formatter: '.getItemCategoryText'}" />
              <Label text="Material:" />
              <Text text="{Matnr}" />
              <Label text="Short Text:" />
              <Text text="{Txz01}" />
              <Label text="Material Group:" />
              <Text text="{Matkl}" />
            </VBox>
            <!-- RIGHT BOX -->
            <VBox id="vboxBasicRight" width="48%">
              <Label text="Requested By:" />
              <Text text="{Ernam}" />
              <Label text="Valuation Price:" />
              <Text text="{Preis} {Waers}" />
              <Label text="Price Unit:" />
              <Text text="{Peinh} EA" />
              <Label text="Quantity Requested:" />
              <Text text="{path:'Menge', formatter:'.formatter.quantityFormat'} {Meins}" />
              <!-- <Label text="Release Status:" /> -->
              <!-- <ObjectStatus text="{parts:[{path:'Frgkz'}, {path:'ReasonId'}], formatter:'.formatter.statusTextt'}" 
                            state="{parts:[{path:'Frgkz'}, {path:'ReasonId'}], formatter:'.formatter.statusStatee'}"/> -->
            </VBox>
          </HBox>
        </Panel>
        <!-- ==== RIGHT COLUMN: DELIVERY SECTION ==== -->
        <form:SimpleForm
          id="formDelivery"
          layout="ResponsiveGridLayout"
          editable="false"
          title="Delivery"
          labelSpanL="5"
          labelSpanM="6"
          columnsL="1"
          columnsM="1">
          <Label text="Delivery Date" />
          <Text text="{path: 'Lfdat', formatter: '.formatter.dateFormat'}" />
          <Label text="Delivery Address" />
          <Text text="Viet Nam" />
          <Label text="Purchase Organization" />
          <Text text="{Ekorg}" />
          <Label text="Purchasing Group" />
          <Text text="{Ekgrp}" />
        </form:SimpleForm>
      </l:Grid>
    </content>
  </Page>
</mvc:View>