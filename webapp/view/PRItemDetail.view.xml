<mvc:View
  controllerName="demodashboard.controller.PRItemDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:form="sap.ui.layout.form"
  xmlns:l="sap.ui.layout"
  displayBlock="true">

  <Page title="PR Item Detail">
    <headerContent>
      <Button icon="sap-icon://nav-back" press="onNavBack" type="Transparent" />
    </headerContent>

    <content>
      <!-- Header hiển thị PR và Item -->
    <ObjectHeader
  id="objHeader"
  title="PR"
  number="{Bnfpo}"
  numberUnit="Item"
  intro="{Txz01}"
  class="sapUiMediumMarginBottom fioriHeaderBox" />


      <!-- GRID CHIA 2 CỘT -->
      <l:Grid
        id="detailGrid"
        defaultSpan="L6 M12 S12"
        hSpacing="2"
        vSpacing="1"
        class="sapUiMediumMarginBottom">

        <!-- ==== CỘT TRÁI: BASIC DATA ==== -->
        <Panel
  headerText="Basic Data"
  expandable="false"
  class="sapUiNoContentPadding sapUiSmallMarginBottom fioriSectionBox">

  <HBox
    class="sapUiSmallMarginTop sapUiSmallMarginBottom sapUiTinyMarginBegin sapUiTinyMarginEnd sapUiSmallScreenColumn"
    justifyContent="SpaceBetween">

    <!-- 🟩 CỘT TRÁI -->
    <VBox width="48%" class="sapUiSmallMarginEnd">
      <Label text="Item Category" />
      <Text text="{path: 'Pstyp', formatter: '.getItemCategoryText'}" />

      <Label text="Requested By" />
      <Text text="{Ernam}" />

      <Label text="Created By (Name)" />
      <Text text="{Ernam}" />

      <Label text="Material" />
      <Link text="{Txz01}" press=".onMaterialPress" />

      <Label text="Short Text" />
      <Text text="{Txz01}" />

      <Label text="Material Group" />
      <Text text="{Matkl}" />
    </VBox>

    <!-- 🟦 CỘT PHẢI -->
    <VBox width="48%">
      <Label text="Valuation Price" />
      <Text text="{Preis} {Waers}" />

      <Label text="Price Unit" />
      <Text text="{Peinh} EA" />

      <Label text="Quantity Requested" />
      <Text text="{Menge} {Meins}" />

      <Label text="Net Value" />
      <Text text="{Netwr} {Waers}" />

      <Label text="Release Status" />
      <Text text="{Frgkz}" />
    </VBox>

  </HBox>
</Panel>


        <!-- ==== CỘT PHẢI: DELIVERY ==== -->
        <form:SimpleForm
          layout="ResponsiveGridLayout"
          editable="false"
          title="Delivery"
          labelSpanL="5"
          labelSpanM="6"
          columnsL="1"
          columnsM="1">

          <Label text="Delivery Date" />
          <Text text="{path: 'Lfdat', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd/MM/yyyy'}}" />

          <Label text="Delivery Address" />
          <Text text="Việt Nam" />
        </form:SimpleForm>
      </l:Grid>


      
    </content>
  </Page>
</mvc:View>
