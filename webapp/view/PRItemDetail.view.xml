<mvc:View
  controllerName="demodashboard.controller.PRItemDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:form="sap.ui.layout.form"
  xmlns:l="sap.ui.layout"
  displayBlock="true">
  <Page id="pagePRItemDetail" title="📦 PR Item Detail">
    <!-- ===== HEADER BUTTON ===== -->
    <headerContent>
      <Button id="btnNavBack" icon="sap-icon://nav-back" press="onNavBack" type="Transparent" />
    </headerContent>
    <content>
      <!-- 🧾 HEADER SECTION -->
      <HBox id="hboxHeader" class="customHeaderBox" alignItems="Center" justifyContent="SpaceBetween">
        <!-- 🟩 LEFT COLUMN: IMAGE -->
        <VBox id="vboxHeaderImage" width="25%" alignItems="Center" class="headerImageContainer">
          <Image
            id="imgMaterial"
            src="/images/tuanthanden.jpg"
            width="140px"
            height="140px"
            decorative="false"
            densityAware="false"
            class="headerProfileImage" />
        </VBox>
        <!-- 🟦 RIGHT COLUMN: BASIC INFO -->
        <VBox id="vboxHeaderInfo" width="75%" class="headerInfoContainer">
          <Text id="txtHeaderDesc" text="{Txz01}" class="headerIntroText" />
          <Title id="txtHeaderTitle" text="{= 'PR ' + ${Banfn}}" level="H2" class="headerTitleText" />
          <HBox id="hboxItemNumber" alignItems="Center" class="headerItemBox">
            <ObjectNumber id="objItemNumber" unit="Item" number="{Bnfpo}" emphasized="true" class="headerItemNumber" />
          </HBox>
        </VBox>
      </HBox>
      <!-- GRID: TWO COLUMN LAYOUT -->
      <l:Grid
        id="gridDetail"
        defaultSpan="L6 M12 S12"
        hSpacing="2"
        vSpacing="1"
        class="sapUiMediumMarginBottom">
        <!-- ==== LEFT COLUMN: BASIC DATA ==== -->
        <Panel
          id="panelBasicData"
          headerText="Basic Data"
          expandable="false"
          class="sapUiNoContentPadding sapUiSmallMarginBottom fioriSectionBox">
          <HBox
            id="hboxBasicData"
            class="sapUiSmallMarginTop sapUiSmallMarginBottom sapUiTinyMarginBegin sapUiTinyMarginEnd sapUiSmallScreenColumn"
            justifyContent="SpaceBetween">
            <!-- LEFT BOX -->
            <VBox id="vboxBasicLeft" width="48%" class="sapUiSmallMarginEnd">
              <Label id="lblItemCategory" text="Item Category:" />
              <Text id="txtItemCategory" text="{path: 'Pstyp', formatter: '.getItemCategoryText'}" />
              <Label id="lblRequestedBy" text="Requested By:" />
              <Text id="txtRequestedBy" text="{Ernam}" />
              <Label id="lblCreatedBy" text="Created By (Name):" />
              <Text id="txtCreatedBy" text="{Ernam}" />
              <Label id="lblMaterial" text="Material:" />
              <Link id="lnkMaterial" text="{Txz01}" press=".onMaterialPress" />
              <Label id="lblShortText" text="Short Text:" />
              <Text id="txtShortText" text="{Txz01}" />
              <Label id="lblMaterialGroup" text="Material Group:" />
              <Text id="txtMaterialGroup" text="{Matkl}" />
            </VBox>
            <!-- RIGHT BOX -->
            <VBox id="vboxBasicRight" width="48%">
              <Label id="lblValuationPrice" text="Valuation Price:" />
              <Text id="txtValuationPrice" text="{Preis} {Waers}" />
              <Label id="lblPriceUnit" text="Price Unit:" />
              <Text id="txtPriceUnit" text="{Peinh} EA" />
              <Label id="lblQuantity" text="Quantity Requested:" />
              <Text id="txtQuantity" text="{Menge} {Meins}" />
              <Label id="lblNetValue" text="Net Value:" />
              <Text id="txtNetValue" text="{Netwr} {Waers}" />
              <Label id="lblReleaseStatus" text="Release Status:" />
              <Text id="txtReleaseStatus" text="{path: 'Frgkz', formatter: '.getReleaseStatus'}" />
            </VBox>
          </HBox>
        </Panel>
        <!-- ==== RIGHT COLUMN: DELIVERY SECTION ==== -->
        <form:SimpleForm
          id="formDelivery"
          layout="ResponsiveGridLayout"
          editable="false"
          title="Delivery"
          labelSpanL="5"
          labelSpanM="6"
          columnsL="1"
          columnsM="1">
          <Label id="lblDeliveryDate" text="Delivery Date" />
          <Text id="txtDeliveryDate" text="{path: 'Lfdat', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd/MM/yyyy'}}" />
          <Label id="lblDeliveryAddress" text="Delivery Address" />
          <Text id="txtDeliveryAddress" text="Viet Nam" />
        </form:SimpleForm>
      </l:Grid>
    </content>
  </Page>
</mvc:View>