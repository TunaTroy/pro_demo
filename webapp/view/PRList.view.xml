<mvc:View
  controllerName="demodashboard.controller.PRList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page id="pagePRList" title="📄 Purchase Requisition List">

    <!-- ===== HEADER BUTTONS ===== -->
    <headerContent>
      <HBox id="headerButtons" alignItems="Center" justifyContent="End" class="sapUiTinyMarginEnd sapUiTinyMarginTop">
        <Button id="btnHome" icon="sap-icon://home" text="Home" press="onNavHome" type="Transparent"/>
        <Button id="btnReload" icon="sap-icon://refresh" text="Reload" press="onGoFilter" type="Transparent"/>
        <Button id="btnExportExcel" icon="sap-icon://excel-attachment" text="Export Excel" press="onExportExcel" type="Transparent"/>
      </HBox>
    </headerContent>

    <content>

      <!-- 🔍 FILTER PANEL -->
      <Panel
        id="panelFilter"
        headerText="Filter Criteria"
        expandable="true"
        class="sapUiNoContentPadding sapUiResponsiveContentPadding sapUiSizeCompact filterPanel">

        <l:Grid
          id="gridFilter"
          defaultSpan="L2 M4 S6"
          hSpacing="1"
          vSpacing="0.5"
          class="sapUiTinyMarginBottom">

          <VBox id="vboxBanfn" width="12rem">
            <Label id="lblBanfn" text="Purchase Req."/>
            <Input id="inpBanfn" placeholder="Select PR No." showValueHelp="true" valueHelpRequest="onValueHelpBanfn"/>
          </VBox>

          <VBox id="vboxBsart" width="12rem">
            <Label id="lblBsart" text="Document Type"/>
            <Input id="inpBsart" placeholder="Select Doc Type" showValueHelp="true" valueHelpRequest="onValueHelpBsart"/>
          </VBox>

          <VBox id="vboxEkgrp" width="12rem">
            <Label id="lblEkgrp" text="Purchasing Group"/>
            <Input id="inpEkgrp" placeholder="Select Group" showValueHelp="true" valueHelpRequest="onValueHelpEkgrp"/>
          </VBox>

          <VBox id="vboxErnam" width="12rem">
            <Label id="lblErnam" text="Created By"/>
            <Input id="inpErnam" placeholder="Select User" showValueHelp="true" valueHelpRequest="onValueHelpErnam"/>
          </VBox>

          <VBox id="vboxDateRange" width="14rem">
            <Label id="lblDateRange" text="Requisition Date Range"/>
            <DateRangeSelection
              id="inpDateRange"
              delimiter=" to "
              displayFormat="dd/MM/yyyy"
              valueFormat="yyyy-MM-dd"
              placeholder="Select date range"
              width="100%"/>
          </VBox>

          <HBox id="hboxFilterButtons" class="customMarginTop">
            <Button id="btnGo" text="Go" type="Emphasized" press="onGoFilter"/>
            <Button id="btnClear" text="Clear" icon="sap-icon://refresh" press="onClearFilter" type="Transparent"/>
          </HBox>

        </l:Grid>
      </Panel>

      <!-- 📋 TABLE + DETAIL -->
      <l:ResponsiveSplitter id="splitPR" defaultPane="paneMaster">
        <l:PaneContainer id="paneContainerMain" orientation="Horizontal">

          <!-- LEFT TABLE -->
          <l:SplitPane id="paneMaster">
            <l:layoutData>
              <l:SplitterLayoutData id="layoutMaster" size="100%" resizable="true"/>
            </l:layoutData>

            <Table
              id="tblPRList"
              items="{ path: '/groups' }"
              mode="SingleSelectLeft"
              selectionChange="onSelectPR"
              class="sapUiSizeCompact stickyTable"
              growing="true"
              growingThreshold="100"
              growingScrollToLoad="true"
              width="100%">

              <noData>
                <IllustratedMessage
                  id="msgNoData"
                  illustrationType="sapIllus-NoData"
                  title="No matching Purchase Requisitions found"
                  description="Try adjusting your filters or clear all filters to see more results."/>
              </noData>

              <columns>
                <Column id="colBanfn"><Text id="txtColBanfn" text="Purchase Requisition"/></Column>
                <Column id="colBsart"><Text id="txtColBsart" text="Document Type"/></Column>
                <Column id="colEkgrp"><Text id="txtColEkgrp" text="Purchasing Group"/></Column>
                <Column id="colErnam"><Text id="txtColErnam" text="Created By"/></Column>
                <Column id="colBadat"><Text id="txtColBadat" text="Requisition Date"/></Column>
                <Column id="colItemCount"><Text id="txtColItemCount" text="Item Count"/></Column>
                <Column id="colStatus"><Text id="txtColStatus" text="Status"/></Column>
              </columns>

              <items>
                <ColumnListItem id="listItemPR" type="Active" press="onSelectPR" vAlign="Top">
                  <cells>
                    <Link id="lnkBanfn" text="{path:'Banfn', formatter:'.formatter.padBanfn'}"/>
                    <Text id="txtBsart" text="{path:'Bsart', formatter:'.formatter.docTypeText'}"/>
                    <Text id="txtEkgrp" text="{Ekgrp}"/>
                    <Text id="txtErnam" text="{Ernam}"/>
                    <Text id="txtBadat" text="{path:'Badat', formatter:'.formatter.dateFormat'}"/>
                    <Text id="txtItemCount" text="{ItemCount}"/>
                    <ObjectStatus
                      id="statusFrgkz"
                      text="{path:'Frgkz', formatter:'.formatter.statusText'}"
                      state="{path:'Frgkz', formatter:'.formatter.statusState'}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </l:SplitPane>

          <!-- RIGHT DETAIL PANEL -->
          <l:SplitPane id="paneDetail">
            <VBox
              id="detailPanel"
              visible="false"
              class="sapUiMediumMargin sapUiSizeCompact sapUiNoContentPadding">

              <Panel
                id="panelDetailHeader"
                class="sapUiNoContentPadding sapUiResponsiveContentPadding sapUiSizeCompact sapUiMediumMarginBottom"
                width="100%">

                <VBox id="vboxDetailHeader" class="sapUiSmallMargin sapUiSizeCompact">
                  <HBox id="hboxDetailHeaderTop" justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
                    <Text id="txtBanfnDetail" text="{path:'Banfn', formatter:'.formatter.padBanfn'}"/>
                    <Button id="btnCloseDetail" icon="sap-icon://decline" press="onCloseDetail" type="Transparent"/>
                  </HBox>

                  <Text id="txtBsartDetail" text="{Bsart}" class="prHeaderSubTitle"/>

                  <HBox id="hboxDetailMeta" class="sapUiTinyMarginTop" wrap="Wrap">
                    <Text id="txtDetailMeta" text="{= 'Group: ' + ${Ekgrp} + ' • Created By: ' + ${Ernam} + ' • Req. Date: ' + ${path:'Badat', formatter:'.formatter.dateFormat'} }"/>
                  </HBox>

                  <HBox id="hboxDetailStatus" class="sapUiTinyMarginTop" alignItems="Center">
                    <Text id="lblStatus" text="Status:"/>
                    <ObjectStatus
                      id="statusDetail"
                      text="{path:'Frgkz', formatter:'.formatter.statusText'}"
                      state="{path:'Frgkz', formatter:'.formatter.statusState'}"
                      class="sapUiTinyMarginBegin"/>
                  </HBox>
                </VBox>
              </Panel>

              <HBox id="hboxActionButtons" class="sapUiTinyMarginBottom" justifyContent="End">
                <Button id="btnApproveAll" icon="sap-icon://accept" text="Approve All Items" type="Emphasized" press="onApprovePR"/>
                <Button id="btnRejectAll" icon="sap-icon://decline" text="Reject All Items" type="Reject" press="onRejectPR" class="sapUiTinyMarginBegin"/>
              </HBox>

              <Panel
                id="panelItems"
                headerText="📦 Items"
                class="sapUiNoContentPadding sapUiResponsiveContentPadding sapUiSizeCompact"
                width="100%">

                <Table
                  id="tblPRItems"
                  mode="SingleSelectMaster"
                  selectionChange="onSelectItem"
                  items="{path:'/Items'}"
                  class="sapUiSizeCompact"
                  width="100%">

                  <columns>
                    <Column id="colItem"><Text id="txtColItem" text="Item"/></Column>
                    <Column id="colMaterial"><Text id="txtColMaterial" text="Material"/></Column>
                    <Column id="colQuantity"><Text id="txtColQuantity" text="Quantity"/></Column>
                    <Column id="colReqDate"><Text id="txtColReqDate" text="Requisition Date"/></Column>
                    <Column id="colItemStatus"><Text id="txtColItemStatus" text="Status"/></Column>
                  </columns>

                  <items>
                    <ColumnListItem id="listItemPRItem">
                      <cells>
                        <Text id="txtBnfpo" text="{Bnfpo}"/>
                        <Text id="txtTxz01" text="{Txz01}"/>
                        <Text id="txtMenge" text="{path:'Menge', formatter:'.formatter.quantityFormat'}" textAlign="End"/>
                        <Text id="txtBadatItem" text="{path:'Badat', formatter:'.formatter.dateFormat'}"/>
                        <ObjectStatus
                          id="statusFrgkzItem"
                          text="{path:'Frgkz', formatter:'.formatter.statusText'}"
                          state="{path:'Frgkz', formatter:'.formatter.statusState'}"/>
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>
              </Panel>

              <Panel
                id="panelNote"
                headerText="📝 Note"
                class="sapUiNoContentPadding sapUiResponsiveContentPadding sapUiSizeCompact sapUiMediumMarginTop prHeaderCard"
                width="100%">

                <VBox id="vboxNote" class="sapUiSmallMargin sapUiSizeCompact">
                  <Text
                    id="txtPRNote"
                    text="{noteModel>/Note}"
                    wrapping="true"
                    visible="{= !${noteModel>/Editable} }"
                    class="sapUiTinyMarginTop sapUiSmallMarginBottom sapUiSmallPadding"/>

                  <TextArea
                    id="taPRNoteEdit"
                    value="{noteModel>/Note}"
                    rows="4"
                    width="100%"
                    visible="{noteModel>/Editable}"
                    placeholder="Enter note here..."
                    class="sapUiTinyMarginTop sapUiSmallMarginBottom sapUiSmallPadding"/>

                  <HBox id="hboxNoteButtons" class="sapUiTinyMarginTop" justifyContent="End">
                    <Button
                      id="btnEditNote"
                      text="Edit"
                      type="Transparent"
                      icon="sap-icon://edit"
                      visible="{= !${noteModel>/Editable} }"
                      press=".onEditNote"/>
                    <Button
                      id="btnSaveNote"
                      text="Save"
                      type="Emphasized"
                      icon="sap-icon://save"
                      visible="{noteModel>/Editable}"
                      press=".onSaveNote"/>
                    <Button
                      id="btnCancelEdit"
                      text="Cancel"
                      type="Reject"
                      icon="sap-icon://decline"
                      visible="{noteModel>/Editable}"
                      press=".onCancelEditNote"/>
                  </HBox>
                </VBox>
              </Panel>

            </VBox>
          </l:SplitPane>

        </l:PaneContainer>
      </l:ResponsiveSplitter>

    </content>
  </Page>
</mvc:View>
