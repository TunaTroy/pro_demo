<mvc:View
  controllerName="demodashboard.controller.POItemDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:form="sap.ui.layout.form"
  xmlns:l="sap.ui.layout"
  displayBlock="true">

  <Page id="pagePOItemDetail" title="📦 PO Item Detail">
    <!-- ===== HEADER BUTTON ===== -->
    <headerContent>
      <Button
        id="btnNavBackPo"
        icon="sap-icon://nav-back"
        press=".onNavBack"
        type="Transparent" />
    </headerContent>

    <content>
      <!-- 🧾 HEADER SECTION -->
      <HBox
        id="hboxHeaderPo"
        class="customHeaderBox"
        alignItems="Center"
        justifyContent="SpaceBetween">

        <!-- 🟩 LEFT COLUMN: IMAGE -->
        <VBox
          id="vboxHeaderImagepo"
          width="25%"
          alignItems="Center"
          class="headerImageContainer">
          <Image
            id="imgMaterialPo"
            src="/images/tuandat.jpg"
            width="140px"
            height="140px"
            decorative="false"
            densityAware="false"
            class="headerProfileImage" />
        </VBox>

        <!-- 🟦 RIGHT COLUMN: BASIC INFO -->
        <VBox
          id="vboxHeaderInfoPo"
          width="75%"
          class="headerInfoContainer">
          <Text
            id="txtHeaderDescPo"
            text="{Txz01}"
            class="headerIntroText" />
          <Title
            id="txtHeaderTitlePo"
            text="{= 'PO ' + ${Ebeln}}"
            level="H2"
            class="headerTitleText" />
          <HBox
            id="hboxItemNumberPo"
            alignItems="Center"
            class="headerItemBox">
            <ObjectNumber
              id="objItemNumberPo"
              unit="Item"
              number="{Ebelp}"
              emphasized="true"
              class="headerItemNumber" />
          </HBox>
        </VBox>
      </HBox>

      <!-- GRID: TWO COLUMN LAYOUT -->
      <l:Grid
        id="gridDetailPo"
        defaultSpan="L6 M12 S12"
        hSpacing="2"
        vSpacing="1"
        class="sapUiMediumMarginBottom">

        <!-- ==== LEFT COLUMN: BASIC DATA ==== -->
        <Panel
          id="panelBasicDataPo"
          headerText="Basic Data"
          expandable="false"
          class="sapUiNoContentPadding sapUiSmallMarginBottom fioriSectionBox">

          <HBox
            id="hboxBasicDataPo"
            class="sapUiSmallMarginTop sapUiSmallMarginBottom sapUiTinyMarginBegin sapUiTinyMarginEnd sapUiSmallScreenColumn"
            justifyContent="SpaceBetween">

            <!-- LEFT BOX -->
            <VBox
              id="vboxBasicLeftPo"
              width="48%"
              class="sapUiSmallMarginEnd">
              <Label text="Material:" />
              <Text text="{Matnr}" />
              <Label text="Description:" />
              <Text text="{Txz01}" />
              <Label text="Quantity:" />
              <Text text="{Menge} {Meins}" />
              <Label text="Net Price:" />
              <Text text="{Netpr} {Waers}" />
              <Label text="Price Unit:" />
              <Text text="{Peinh}" />
            </VBox>

            <!-- RIGHT BOX -->
            <VBox
              id="vboxBasicRightPo"
              width="48%">
              <Label text="Plant:" />
              <Text text="{Werks}" />
              <Label text="Storage Location:" />
              <Text text="{Lgort}" />
              <Label text="Delivery Date:" />
              <Text text="{path:'Agdat', formatter:'.formatter.dateFormat'}" />
              <Label text="Created By:" />
              <Text text="{Ernam}" />
              <Label text="Vendor:" />
              <Text text="{Lifnr}" />
            </VBox>
          </HBox>
        </Panel>

        <!-- ==== RIGHT COLUMN: DELIVERY SECTION ==== -->
        <form:SimpleForm
          id="formDeliveryPo"
          layout="ResponsiveGridLayout"
          editable="false"
          title="Delivery"
          labelSpanL="5"
          labelSpanM="6"
          columnsL="1"
          columnsM="1">

          <Label text="Delivery Date" />
          <Text text="{path:'Agdat', formatter:'.formatter.dateFormat'}" />

          <Label text="Delivery Address" />
          <Text text="{Adrnr}" />

          <Label text="Incoterms" />
          <Text text="{Inco1}" />
        </form:SimpleForm>
      </l:Grid>
    </content>
  </Page>
</mvc:View>
