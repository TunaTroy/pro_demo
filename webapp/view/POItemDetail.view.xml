<mvc:View
  controllerName="demodashboard.controller.POItemDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:form="sap.ui.layout.form"
  xmlns:l="sap.ui.layout"
  displayBlock="true">

<Page id="pagePOItemDetail" showHeader="true">

  <customHeader>
    <Bar>
      <contentLeft>
        <Button
          id="btnNavBackPo"
          icon="sap-icon://nav-back"
          press=".onNavBack"
          type="Transparent" />
      </contentLeft>

      <contentMiddle>
        <Title text="📦 PO Item Detail" />
      </contentMiddle>
    </Bar>
  </customHeader>

    <content>
      <!-- 🧾 HEADER SECTION -->
      <HBox
        id="hboxHeaderPo"
        class="customHeaderBox"
        alignItems="Center"
        justifyContent="SpaceBetween">

        <!-- 🟩 LEFT COLUMN: IMAGE -->
        <VBox
          id="vboxHeaderImagepo"
          width="25%"
          alignItems="Center"
          class="headerImageContainer">
          <Image
            id="imgMaterialPo"
            src="images/doanhnhan.jpg"
            width="180px"
            height="180px"
            decorative="false"
            densityAware="false"
            class="headerProfileImage" />
        </VBox>

        <!-- 🟦 RIGHT COLUMN: BASIC INFO -->
        <VBox
          id="vboxHeaderInfoPo"
          width="75%"
          class="headerInfoContainer">
          <Text
            id="txtHeaderDescPo"
            text="{Txz01}"
            class="headerIntroText" />
          <Title
            id="txtHeaderTitlePo"
            text="{= 'PO ' + ${Ebeln}}"
            level="H2"
            class="headerTitleText" />
          <HBox
            id="hboxItemNumberPo"
            alignItems="Center"
            class="headerItemBox">
            <ObjectNumber
              id="objItemNumberPo"
              unit="Item"
              number="{Ebelp}"
              emphasized="true"
              class="headerItemNumber" />
          </HBox>
        </VBox>
      </HBox>

      <!-- GRID: TWO COLUMN LAYOUT -->
      <l:Grid
        id="gridDetailPo"
        defaultSpan="L6 M12 S12"
        hSpacing="2"
        vSpacing="1"
        class="sapUiMediumMarginBottom">

        <!-- ==== LEFT COLUMN: BASIC DATA ==== -->
        <Panel
          id="panelBasicDataPo"
          headerText="Basic Data"
          expandable="false"
          class="sapUiNoContentPadding sapUiSmallMarginBottom fioriSectionBox">

          <HBox
            id="hboxBasicDataPo"
            class="sapUiSmallMarginTop sapUiSmallMarginBottom sapUiTinyMarginBegin sapUiTinyMarginEnd sapUiSmallScreenColumn"
            justifyContent="SpaceBetween">

            <!-- LEFT BOX -->
            <VBox
              id="vboxBasicLeftPo"
              width="48%"
              class="sapUiSmallMarginEnd">
              <Label text="Material:" />
              <Text text="{Matnr}" />
              <Label text="Material Group:" />
              <Text text="{Matkl}" />
              <Label text="Company Code:" />
              <Text text="{Bukrs}" />
              <Label text="Order Quantity:" />
              <Text text="{Menge} {Meins}" />
             
            </VBox>

            <!-- RIGHT BOX -->
            <VBox
              id="vboxBasicRightPo"
              width="48%">           
              <Label text="Changed On:" />
              <Text text="{path:'Aedat', formatter:'.formatter.dateFormat'}" />
              <Label text="Net Value:" />
              <Text text="{Netwr}" />
               <Label text="Net Price:" />
              <Text text="{Netpr} {Waers}" />
              <Label text="Price Unit:" />
              <Text text="{Peinh}" />
              
            </VBox>
          </HBox>
        </Panel>

        <!-- ==== RIGHT COLUMN: DELIVERY SECTION ==== -->
        <form:SimpleForm
          id="formDeliveryPo"
          layout="ResponsiveGridLayout"
          editable="false"
          title="Delivery"
          labelSpanL="5"
          labelSpanM="6"
          columnsL="1"
          columnsM="1">

          <Label text="Storage Location" />
          <Text text="{Lgort}" />
          <Label text="Plant" />
          <Text text="{Werks}" />        
          <Label text="Incoterms" />
          <Text text="{Inco1}" />
        </form:SimpleForm>
      </l:Grid>
    </content>
  </Page>
</mvc:View>