<mvc:View xmlns:mvc="sap.ui.core.mvc"
          xmlns="sap.m"
          xmlns:core="sap.ui.core"
          xmlns:viz="sap.viz.ui5.controls"
          xmlns:viz.data="sap.viz.ui5.data"
          xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
          controllerName="demodashboard.controller.Dashboard">

  <Page id="dashboard" title="Dashboard" enableScrolling="true">
    <content>

      <VBox id="vbox2" width="100%" class="dashboardContainer">

        <!-- Bộ lọc thời gian -->
        <HBox id="_IDGenHBox"
              alignItems="Center"
              justifyContent="End"
              width="100%"
              class="filterBar">
          <Label text="Time Filter:" labelFor="timeFilter" class="sapUiSmallMarginEnd"/>
          <Select id="timeFilter"
                  change="onTimeFilterChange"
                  selectedKey="thisMonth"
                  class="sapUiSmallMarginEnd">
            <items>
              <core:Item key="today" text="Today" />
              <core:Item key="thisWeek" text="This Week" />
              <core:Item key="thisMonth" text="This Month" />
              <core:Item key="thisQuarter" text="This Quarter" />
              <core:Item key="thisYear" text="This Year" />
            </items>
          </Select>
        </HBox>

        <!-- Row ngang: KPI - Donut - Bar -->
        <HBox id="dashboardMainRow"
              wrap="Wrap"
              alignItems="Start"
              justifyContent="SpaceBetween"
              class="dashboardMainRow">

          <!-- KPI Card Container -->
          <VBox id="kpiSection" width="32%">
            <HBox id="kpiContainer"
                  wrap="Wrap"
                  alignItems="Start"
                  justifyContent="Start"
                  width="100%">
              <!-- KPI cards load từ controller -->
            </HBox>
          </VBox>

          <!-- Donut Chart -->
          <VBox id="donutChartSection"  width="32%">
            <viz:VizFrame
              id="idDonutChart"
              vizType="donut"
              width="100%"
              height="200px" />
          </VBox>

          <!-- Bar Chart -->
          <VBox id="barChartSection" width="32%">
            <viz:VizFrame
              id="idBarChart"
              vizType="bar"
              width="100%"
              height="200px" />
          </VBox>

        </HBox>

        <!-- Nút chuyển sang PR List -->
        <Button id="button2"
                text="Go to PR List"
                press="onGoToPRList"
                class="sapUiSmallMarginTop" />

      </VBox>

    </content>
  </Page>
</mvc:View>
