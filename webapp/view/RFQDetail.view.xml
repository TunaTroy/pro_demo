<mvc:View
    controllerName="demodashboard.controller.RFQDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true"
>
    <Page
        id="rfqDetailPage"
        title="📄 RFQ Detail"
    >
        <!-- ================================= -->
        <!-- BACK BUTTON -->
        <!-- ================================= -->
        <headerContent>
            <Button
                icon="sap-icon://nav-back"
                type="Transparent"
                press=".onNavBack"
            />
        </headerContent>
        <content>
            <!-- ================================= -->
            <!-- 1) HEADER RFQ (Avatar + RFQ info) -->
            <!-- ================================= -->
            <HBox
                id="rfqHeaderBox"
                class="customHeaderBox"
                alignItems="Center"
                justifyContent="SpaceBetween"
            >
                <!-- LEFT: Avatar -->
                <VBox
                    width="25%"
                    alignItems="Center"
                    class="headerImageContainer"
                >
                    <Image
                        src="images/user.png"
                        width="140px"
                        height="140px"
                        decorative="false"
                        class="headerProfileImage"
                    />
                </VBox>
                <!-- RIGHT: RFQ Information -->
                <VBox
                    width="75%"
                    class="headerInfoContainer"
                >
                    <!-- DESCRIPTION (Txz01) -->
                    <Text
                        text="{rfq>/Txz01}"
                        class="headerIntroText"
                    />
                    <!-- RFQ NUMBER (Value only) -->
                    <Title
                        text="{rfq>/Ebeln}"
                        level="H2"
                        class="headerTitleText"
                    />
                    <!-- STATUS USING SAME FORMATTER AS LIST -->
                    <HBox
                        alignItems="Center"
                        class="headerItemBox"
                    >
                        <ObjectStatus
                            text="{ path:'rfq>/Statu', formatter:'.formatter.statusText' }"
                            state="{ path:'rfq>/Statu', formatter:'.formatter.statusState' }"
                            inverted="false"
                        />
                    </HBox>
                </VBox>
            </HBox>
            <!-- ================================= -->
            <!-- GRID 2 COLUMN LAYOUT FOR SECTIONS -->
            <!-- ================================= -->
            <l:Grid
                defaultSpan="L6 M12 S12"
                hSpacing="2"
                vSpacing="1"
                class="sapUiMediumMarginBottom"
            >
                <!-- ================================= -->
                <!-- 2) BASIC DATA PANEL -->
                <!-- ================================= -->
                <Panel
    headerText="Basic Data"
    expandable="false"
    class="sapUiNoContentPadding sapUiSmallMarginBottom fioriSectionBox"
>
                    <HBox justifyContent="SpaceBetween" class="sapUiSmallMargin">
                        <!-- LEFT COLUMN -->
                        <VBox width="48%">
                            <Label text="Created By:" />
                            <Text text="{rfq>/Ernam}" />
                            <Label text="Created On:" />
                            <Text
                text="{ path:'rfq>/Aedat', formatter:'.formatter.dateFormat' }"
            />
                            <Label text="Purchasing Group:" />
                            <Text
                text="{ path:'rfq>/Ekgrp', formatter:'.formatter.purchGroupText' }"
            />
                            <!-- RFQ Type (BSART) -->
                            <Label text="RFQ Type:" />
                            <Text 
                text="{ path:'rfq>/Bsart', formatter:'.formatter.rfqTypeText' }"
            />
                        </VBox>
                        <!-- RIGHT COLUMN -->
                        <VBox width="48%">
                            <Label text="Purchasing Org:" />
                            <Text 
                text="{ path:'rfq>/Ekorg', formatter:'.formatter.purchOrgText' }"
            />
                            <Label text="Company Code:" />
                            <Text 
                text="{ path:'rfq>/Bukrs', formatter:'.formatter.companyCodeText' }"
            />
                            <Label text="Language:" />
                            <Text text="{rfq>/Spras}" />
                            <!-- Quotation Deadline -->
                            <Label text="Quotation Deadline:" />
                            <Text
                text="{ path:'rfq>/Angdt', formatter:'.formatter.dateFormat' }"
            />
                            <Label text="Target Value:" />
                            <ObjectNumber
                number="{ path:'rfq>/Ktwrt', formatter:'.formatter.numberFormat' }"
                unit="{rfq>/Waers}"
                emphasized="false"
            />
                        </VBox>
                    </HBox>
                </Panel>
                <!-- ================================= -->
                <!-- 3) ITEMS SECTION -->
                <!-- ================================= -->
                <Panel
    headerText="Items"
    expandable="false"
    class="sapUiNoContentPadding sapUiSmallMarginBottom fioriSectionBox"
>
                    <Table items="{rfq>/Items}"
                            mode="SingleSelectMaster" 
                            selectionChange="onItemDetailPress" >
                        <columns>
                            <Column>
                                <Text text="Item" />
                            </Column>
                            <Column>
                                <Text text="Material" />
                            </Column>
                            <Column>
                                <Text text="Material Group" />
                            </Column>
                            <Column>
                                <Text text="Plant" />
                            </Column>
                            <Column>
                                <Text text="Quantity" />
                            </Column>
                        </columns>
                        <ColumnListItem>
                            <cells>
                                <!-- Item number -->
                                <Text text="{rfq>Ebelp}" />
                                <!-- Material number -->
                                <Text text="{rfq>Matnr}" />
                                <!-- Material Group -->
                                <Text text="{rfq>Matkl}" />
                                <!-- Plant -->
                                <Text text="{rfq>Werks}" />
                                <!-- Quantity -->
                                <Text text="{rfq>Menge}" />
                            </cells>
                        </ColumnListItem>
                    </Table>
                </Panel>
                <!-- ================================= -->
                <!-- 4) VENDOR SECTION -->
                <!-- ================================= -->
                <Panel
                    headerText="Vendor"
                    expandable="false"
                    class="sapUiNoContentPadding sapUiSmallMarginBottom fioriSectionBox"
                >
                    <VBox class="sapUiSmallMargin">
                        <Label text="Vendor (Lifnr):" />
                        <Text text="{rfq>/Lifnr}" />
                    </VBox>
                </Panel>
            </l:Grid>
            <!-- ================================= -->
            <!-- 5) NOTES SECTION (FULL WIDTH + ALIGN LEFT/RIGHT LIKE GRID) -->
            <!-- ================================= -->
            <l:Grid
                defaultSpan="L12 M12 S12"
                class="sapUiSmallMarginTop sapUiMediumMarginBottom sapUiMediumMarginBegin sapUiMediumMarginEnd"
            >
                <Panel
                    headerText="Notes"
                    expandable="false"
                    class="sapUiNoContentPadding sapUiSmallMarginBottom fioriSectionBox"
                >
                    <VBox class="sapUiSmallMargin">
                        <TextArea
                            rows="5"
                            editable="false"
                            width="100%"
                            value="{rfq>/Note}"
                        />
                    </VBox>
                </Panel>
            </l:Grid>
        </content>
    </Page>
</mvc:View>