<mvc:View
  controllerName="demodashboard.controller.RFQList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:fb="sap.ui.comp.filterbar"
  displayBlock="true"
  height="100%">
  <Page id="rfqListPage"
    title="Request for Quotation List"
    showNavButton="false"
    class="sapUiResponsiveContentPadding">
    <content>
      <!-- ======== FILTER BAR - Fiori Standard ======== -->
      <fb:FilterBar id="filterBar"
        persistencyKey="rfqFilterBar"
        useToolbar="false"
        search=".onFilterSearch"
        showRestoreButton="true"
        showClearButton="true"
        showGoOnFB="true"
        filterBarExpanded="true">
        <fb:filterGroupItems>
          <!-- RFQ No. -->
          <fb:FilterGroupItem name="Ebeln"
    label="RFQ No."
    groupName="__$INTERNAL$"
    visibleInFilterBar="true"
    partOfCurrentVariant="true">
            <fb:control>
              <MultiInput id="rfqFilter"
        showValueHelp="true"
        valueHelpRequest=".onValueHelpRFQ"
        width="100%"
        placeholder="Enter RFQ Number" />
            </fb:control>
          </fb:FilterGroupItem>
          <fb:FilterGroupItem name="Angdt"
            label="Quotation Deadline"
            groupName="__$INTERNAL$"
            visibleInFilterBar="true">
            <fb:control>
              <DateRangeSelection id="deadlineFilter"
                displayFormat="dd.MM.yyyy"
                width="100%"
                placeholder="Select date range" />
            </fb:control>
          </fb:FilterGroupItem>
          <fb:FilterGroupItem name="Aedat"
            label="Created On"
            groupName="__$INTERNAL$"
            visibleInFilterBar="true">
            <fb:control>
              <DateRangeSelection id="createdFilter"
                displayFormat="dd.MM.yyyy"
                width="100%"
                placeholder="Select date range" />
            </fb:control>
          </fb:FilterGroupItem>
          <!-- Created By -->
          <fb:FilterGroupItem name="Ernam"
    label="Created By"
    groupName="__$INTERNAL$"
    visibleInFilterBar="true"
    partOfCurrentVariant="true">
            <fb:control>
              <MultiInput id="ernamFilter"
        showValueHelp="true"
        valueHelpRequest=".onValueHelpErnam"
        width="100%"
        placeholder="Enter Creator" />
            </fb:control>
          </fb:FilterGroupItem>
          <fb:FilterGroupItem name="Bukrs"
            label="Company Code"
            groupName="__$INTERNAL$"
            visibleInFilterBar="true">
            <fb:control>
              <MultiInput id="bukrsFilter"
                showValueHelp="true"
                valueHelpRequest=".onValueHelpBukrs"
                width="100%"
                placeholder="Enter company code" />
            </fb:control>
          </fb:FilterGroupItem>
          <fb:FilterGroupItem name="Ekorg"
            label="Purchasing Organization"
            groupName="__$INTERNAL$"
            visibleInFilterBar="true">
            <fb:control>
              <MultiInput id="ekorgFilter"
                showValueHelp="true"
                valueHelpRequest=".onValueHelpEkorg"
                width="100%"
                placeholder="Enter purchasing org" />
            </fb:control>
          </fb:FilterGroupItem>
          <fb:FilterGroupItem name="Ekgrp"
            label="Purchasing Group"
            groupName="__$INTERNAL$"
            visibleInFilterBar="true">
            <fb:control>
              <MultiInput id="ekgrpFilter"
                showValueHelp="true"
                valueHelpRequest=".onValueHelpEkgrp"
                width="100%"
                placeholder="Enter purchasing group" />
            </fb:control>
          </fb:FilterGroupItem>
        </fb:filterGroupItems>
      </fb:FilterBar>
      <!-- ======== RESPONSIVE TABLE - Fiori Standard ======== -->
      <Table id="rfqTable"
        items="{
               path: 'rfq>/',
               sorter: {
                 path: 'Aedat',
                 descending: true
               }
             }"
        mode="SingleSelectLeft"
        growing="true"
        growingThreshold="20"
        growingScrollToLoad="true"
        sticky="ColumnHeaders,HeaderToolbar"
        selectionChange=".onSelectionChange"
        class="sapUiSmallMarginTop">
        <headerToolbar>
          <OverflowToolbar design="Transparent">
            <Title text="Requests for Quotations ({rfq>/length})"
              level="H2"
              titleStyle="H4" />
            <ToolbarSpacer />
            <Button icon="sap-icon://excel-attachment"
              text="Export"
              press=".onExport"
              type="Transparent"
              tooltip="Export to Excel" />
            <Button icon="sap-icon://action-settings"
              press=".onTableSettings"
              type="Transparent"
              tooltip="Settings" />
          </OverflowToolbar>
        </headerToolbar>
        <columns>
          <!-- Column 1: RFQ Details -->
          <Column
            width="25%"
            minScreenWidth="Tablet"
            demandPopin="false"
            hAlign="Begin">
            <Text text="RFQ" />
          </Column>
          <!-- Column 2: RFQ Description -->
          <Column
            id="col_description"
            width="25%"
            minScreenWidth="Desktop"
            demandPopin="true"
            hAlign="Begin"
            visible="{view>/columnSettings/description}">
            <Text text="RFQ Description" />
          </Column>
          <!-- Column 3: Company Code -->
          <Column
            id="col_companyCode"
            width="17%"
            minScreenWidth="Desktop"
            demandPopin="true"
            hAlign="Begin"
            visible="{view>/columnSettings/companyCode}">
            <Text text="Company Code" />
          </Column>
          <!-- Column 4: Purchasing Organization -->
          <Column
            id="col_purchOrg"
            width="17%"
            minScreenWidth="Desktop"
            demandPopin="true"
            hAlign="Begin"
            visible="{view>/columnSettings/purchOrg}">
            <Text text="Purchasing Organization" />
          </Column>
          <!-- Column 5: Purchasing Group -->
          <Column
            id="col_purchGroup"
            width="16%"
            minScreenWidth="Desktop"
            demandPopin="true"
            hAlign="Begin"
            visible="{view>/columnSettings/purchGroup}">
            <Text text="Purchasing Group" />
          </Column>
        </columns>
        <items>
          <ColumnListItem type="Navigation" press=".onItemPress">
            <cells>
              <!-- Cell 1: RFQ Details - Dynamic based on field settings -->
              <VBox class="sapUiSmallMarginTopBottom">
                <!-- RFQ Number - Always visible (mandatory) -->
                <HBox class="sapUiTinyMarginTop">
                  <Label text="Request For Quote: " class="sapUiTinyMarginEnd" />
                  <Link text="{rfq>Ebeln}"
                    press=".onRFQPress"
                    emphasized="true">
                    <customData>
                      <core:CustomData key="rfqNo" value="{rfq>Ebeln}" />
                    </customData>
                  </Link>
                </HBox>
                <!-- Target Value -->
                <HBox class="sapUiTinyMarginTop" visible="{view>/fieldSettings/targetValue}">
                  <Label text="Target Value: " class="sapUiTinyMarginEnd" />
                  <ObjectNumber
                    number="{
                      parts: ['rfq>Ktwrt'],
                      formatter: '.formatter.numberFormat'
                    }"
                    unit="{rfq>Waers}"
                    emphasized="false" />
                </HBox>
                <!-- Quotation Deadline -->
                <HBox class="sapUiTinyMarginTop" visible="{view>/fieldSettings/deadline}">
                  <Label text="Quotation Deadline: " class="sapUiTinyMarginEnd" />
                  <Text text="{
                    path: 'rfq>Angdt',
                    formatter: '.formatter.dateFormat'
                  }" />
                </HBox>
                <!-- Status -->
                <!-- <HBox class="sapUiTinyMarginTop" visible="{view>/fieldSettings/status}">
                  <Label text="Status: " class="sapUiTinyMarginEnd" />
                  <ObjectStatus
                    text="{
                      path: 'rfq>Statu',
                      formatter: '.formatter.statusText'
                    }"
                    state="{
                      path: 'rfq>Statu',
                      formatter: '.formatter.statusState'
                    }" />
                </HBox> -->
                <!-- Created On -->
                <HBox class="sapUiTinyMarginTop" visible="{view>/fieldSettings/createdOn}">
                  <Label text="Created On: " class="sapUiTinyMarginEnd" />
                  <Text text="{
                    path: 'rfq>Aedat',
                    formatter: '.formatter.dateFormat'
                  }" />
                </HBox>
                <!-- Created By -->
                <HBox class="sapUiTinyMarginTop" visible="{view>/fieldSettings/createdBy}">
                  <Label text="Created By: " class="sapUiTinyMarginEnd" />
                  <Text text="{rfq>Ernam}" />
                </HBox>
                <!-- Company Code in RFQ column -->
                <HBox class="sapUiTinyMarginTop" visible="{view>/fieldSettings/companyCodeInRFQ}">
                  <Label text="Company Code: " class="sapUiTinyMarginEnd" />
                  <Text text="{
                    path: 'rfq>Bukrs',
                    formatter: '.formatter.companyCodeText'
                  }" />
                </HBox>
                <!-- Purchasing Org in RFQ column -->
                <HBox class="sapUiTinyMarginTop" visible="{view>/fieldSettings/purchOrgInRFQ}">
                  <Label text="Purchasing Org: " class="sapUiTinyMarginEnd" />
                  <Text text="{
                    path: 'rfq>Ekorg',
                    formatter: '.formatter.purchOrgText'
                  }" />
                </HBox>
                <!-- Purchasing Group in RFQ column -->
                <HBox class="sapUiTinyMarginTop" visible="{view>/fieldSettings/purchGroupInRFQ}">
                  <Label text="Purchasing Group: " class="sapUiTinyMarginEnd" />
                  <Text text="{
                    path: 'rfq>Ekgrp',
                    formatter: '.formatter.purchGroupText'
                  }" />
                </HBox>
              </VBox>
              <!-- Cell 2: RFQ Description -->
              <VBox class="sapUiSmallMarginTopBottom">
                <Text
                  text="{rfq>Txz01}"
                  wrapping="true"
                  tooltip="{rfq>Txz01}" />
              </VBox>
              <!-- Cell 3: Company Code -->
              <VBox class="sapUiSmallMarginTopBottom">
                <Text
                  text="{
                  path: 'rfq>Bukrs',
                  formatter: '.formatter.companyCodeText'
                }"
                  wrapping="true" />
              </VBox>
              <!-- Cell 4: Purchasing Organization -->
              <VBox class="sapUiSmallMarginTopBottom">
                <Text
                  text="{
                  path: 'rfq>Ekorg',
                  formatter: '.formatter.purchOrgText'
                }"
                  wrapping="true" />
              </VBox>
              <!-- Cell 5: Purchasing Group -->
              <VBox class="sapUiSmallMarginTopBottom">
                <Text
                  text="{
                  path: 'rfq>Ekgrp',
                  formatter: '.formatter.purchGroupText'
                }"
                  wrapping="true" />
              </VBox>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>