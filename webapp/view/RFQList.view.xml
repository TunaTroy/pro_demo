<mvc:View
  controllerName="demodashboard.controller.RFQList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:table="sap.ui.table"
  xmlns:f="sap.f"
  xmlns:fb="sap.ui.comp.filterbar"
  displayBlock="true">
  
  <Page id="rfqListPage" title="Request for Quotation List" showNavButton="true" navButtonPress=".onNavBack">
    <subHeader>
      <Toolbar>
        <SearchField id="searchField" liveChange=".onSearch" width="300px" placeholder="Search RFQ Number, Vendor..."/>
        <ToolbarSpacer/>
        <Button text="Create RFQ" icon="sap-icon://add-document" type="Emphasized" press=".onCreateRFQ" visible="false"/>
        <Button icon="sap-icon://excel-attachment" tooltip="Export to Excel" press=".onExportExcel"/>
      </Toolbar>
    </subHeader>

    <fb:FilterBar id="filterBar" persistencyKey="rfqFilterBar" useToolbar="false" search=".onFilterSearch">
      <fb:filterGroupItems>
        <fb:FilterGroupItem name="Ebeln" label="RFQ Number" groupName="default" visibleInFilterBar="true">
          <fb:control><MultiInput id="ebelnFilter" showValueHelp="true" valueHelpRequest=".onValueHelpEbeln"/></fb:control>
        </fb:FilterGroupItem>
        <fb:FilterGroupItem name="Lifnr" label="Vendor" groupName="default" visibleInFilterBar="true">
          <fb:control><MultiInput id="vendorFilter" showValueHelp="true" valueHelpRequest=".onValueHelpVendor"/></fb:control>
        </fb:FilterGroupItem>
        <fb:FilterGroupItem name="Aedat" label="Created Date" groupName="default" visibleInFilterBar="true">
          <fb:control><DateRangeSelection id="dateFilter" displayFormat="dd.MM.yyyy"/></fb:control>
        </fb:FilterGroupItem>
        <fb:FilterGroupItem name="Frgke" label="Release Status" groupName="default" visibleInFilterBar="true">
          <fb:control>
            <Select id="statusFilter">
              <items>
                <core:Item key="" text="All"/>
                <core:Item key="R" text="Released"/>
                <core:Item key="C" text="Pending"/>
                <core:Item key="A" text="Blocked"/>
              </items>
            </Select>
          </fb:control>
        </fb:FilterGroupItem>
      </fb:filterGroupItems>
    </fb:FilterBar>

    <Table
      id="rfqTable"
      items="{path: 'rfq>/', parameters: {expand: 'ToItems'}}"
      growing="true"
      growingThreshold="50"
      sticky="ColumnHeaders,HeaderToolbar"
      mode="SingleSelectMaster"
      selectionChange=".onItemPress">
      <headerToolbar>
        <OverflowToolbar>
          <Title text="RFQ List ({= ${rfq>/}.length } items)" level="H2"/>
          <ToolbarSpacer/>
          <Button icon="sap-icon://sort" press=".onSort"/>
          <Button icon="sap-icon://filter" press=".onFilter"/>
        </OverflowToolbar>
      </headerToolbar>
      <columns>
        <Column width="110px"><Text text="RFQ No."/></Column>
        <Column width="100px"><Text text="Created On"/></Column>
        <Column width="90px"><Text text="Status"/></Column>
        <Column width="120px"><Text text="Vendor"/></Column>
        <Column width="100px"><Text text="Purch. Group"/></Column>
        <Column width="90px"><Text text="Currency"/></Column>
        <Column width="120px" hAlign="End"><Text text="Total Value"/></Column>
        <Column width="100px"><Text text="Items"/></Column>
        <Column width="80px"><Text text="Deadline"/></Column>
      </columns>
      <items>
        <ColumnListItem>
          <cells>
            <ObjectIdentifier title="{rfq>Ebeln}" text="{rfq>Bsart}"/>
            <Text text="{path: 'rfq>Aedat', formatter: '.formatter.formatDate'}"/>
            <ObjectStatus
              text="{
                path: 'rfq>Frgke',
                formatter: '.formatter.formatReleaseStatusText'
              }"
              state="{
                path: 'rfq>Frgke',
                formatter: '.formatter.formatReleaseStatusState'
              }"
              icon="{
                path: 'rfq>Frgke',
                formatter: '.formatter.formatReleaseStatusIcon'
              }"/>
            <Text text="{rfq>Lifnr} - {rfq>VendorName}"/>
            <Text text="{rfq>Ekgrp}"/>
            <Text text="{rfq>Waers}"/>
            <ObjectNumber
              number="{rfq>TotalValue}"
              unit="{rfq>Waers}"
              state="{= ${rfq>TotalValue} > 1000000000 ? 'Error' : ${rfq>TotalValue} > 100000000 ? 'Warning' : 'Success'}"/>
            <Text text="{rfq>ItemCount}"/>
            <Text text="{path: 'rfq>ToItems/0/Agdat', formatter: '.formatter.formatDate'}"/>
          </cells>
        </ColumnListItem>
      </items>
    </Table>

    <!-- Footer Note Panel giống PR List -->
    <footer>
      <OverflowToolbar>
        <ToolbarSpacer/>
        <Button text="View Notes" icon="sap-icon://notes" press=".onOpenNotes"/>
      </OverflowToolbar>
    </footer>
  </Page>
</mvc:View>