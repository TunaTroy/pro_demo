<mvc:View xmlns:mvc="sap.ui.core.mvc"
          xmlns="sap.m"
          xmlns:core="sap.ui.core"
          xmlns:viz="sap.viz.ui5.controls"
          xmlns:viz.data="sap.viz.ui5.data"
          xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
          controllerName="demodashboard.controller.DashboardPR">

  <Page id="dashboard" title="Dashboard" enableScrolling="true">
    <content>

      <VBox id="vbox2" width="100%" class="dashboardContainer">

        <!-- Bộ lọc thời gian -->
        <HBox id="_IDGenHBox"
              alignItems="Center"
              justifyContent="End"
              width="100%"
              class="filterBar">
          <Label id="_IDGenLabel" text="Time Filter:" labelFor="timeFilter" class="sapUiSmallMarginEnd"/>
          <Select id="timeFilter"
                  change="onTimeFilterChange"
                  selectedKey="thisYear"
                  class="sapUiSmallMarginEnd">
            <items>
              <core:Item id="_IDGenItem" key="today" text="Today" />
              <core:Item id="_IDGenItem1" key="thisWeek" text="This Week" />
              <core:Item id="_IDGenItem2" key="thisMonth" text="This Month" />
              <core:Item id="_IDGenItem3" key="thisQuarter" text="This Quarter" />
              <core:Item id="_IDGenItem4" key="thisYear" text="This Year" />
              <core:Item id="_IDGenItem7" key="thisAll" text="All" />
            </items>
          </Select>
        </HBox>

        <!-- Row ngang: KPI - Donut - Bar -->
        <HBox id="dashboardMainRow"
              wrap="Wrap"
              alignItems="Start"
              justifyContent="SpaceBetween"
              class="dashboardMainRow">

          <!-- KPI Card Container -->
          <VBox id="kpiSection" class="dashboardCard kpiCard">
        <HBox id="kpiContainer" />
      </VBox>

          <!-- Donut Chart -->
          <VBox id="donutChartSection"  width="32%">
            <viz:VizFrame
              id="idDonutChart"
              vizType="donut"
              width="100%"
              height="200px" />
          </VBox>

          <!-- Bar Chart -->
          <VBox id="barChartSection" width="32%">
            <viz:VizFrame
              id="idBarChart"
              vizType="bar"
              width="100%"
              height="200px" />
          </VBox>

        </HBox>

        <!-- Biểu đồ PR theo tháng -->
          <VBox id="monthlyChartSection" width="100%" class="chartFullRow sapUiSmallMarginTop">
            <viz:VizFrame
              id="idMonthlyBarChart"
              vizType="column"
              width="100%"
              height="500px" />
          </VBox>

        <!-- Top Requester Table -->
          <!-- Top Request Purchase Requisition by Employee -->
          <VBox id="topRequesterSection" class="topRequesterCard" width="100%">
            <HBox alignItems="Center" justifyContent="SpaceBetween" class="topRequesterHeader">
    <Title text="Top Request Purchase Requisition by Employee" />
    <HBox alignItems="Center" class="sortFilterGroup">
      <Label text="Sort by:" class="sortLabel"/>
      <Select id="requesterSortFilter"
              selectedKey="totalPR"
              change=".onRequesterSortChange"
              width="180px">
        <core:Item key="totalPR" text="Total PR Created" />
        <core:Item key="approvalRate" text="Approval Rate (%)" />
      </Select>
    </HBox>
  </HBox>


            <Table id="topRequesterTable"
                inset="false"
                items="{topRequesterModel>/items}"
                fixedLayout="true"
                width="100%"
                growing="false"
                class="topRequesterTableScrollable">

              <columns>
                <Column><Text text="STT" /></Column>
                <Column><Text text="User ID" /></Column>
                <Column><Text text="Total PR" /></Column>
                <Column><Text text="Approved PR" /></Column>
                <Column><Text text="Approval Rate" /></Column>
                <Column><Text text="Pending PR" /></Column>
                <Column><Text text="Last Created Date" /></Column>
                <Column><Text text="Avg Time Approval" /></Column>
                <!-- <Column><Text text="Avg Time Approval" /></Column> -->
              </columns>

              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{topRequesterModel>index}" />
                    <Text text="{topRequesterModel>UserID}" />
                    <Text text="{topRequesterModel>TotalPR}" />
                    <Text text="{topRequesterModel>ApprovedPR}" />
                    <Text text="{topRequesterModel>ApprovalRate}" />
                    <Text text="{topRequesterModel>PendingPR}" />
                    <Text text="{topRequesterModel>LastCreatedDate}" />
                    <ObjectNumber number="{topRequesterModel>AvgApprovalDays}" unit="days" />
                  </cells>
                </ColumnListItem>
              </items>
            </Table> 
          </VBox>




        <!-- Nút chuyển sang PR List -->
        <Button id="button2"
                text="Go to PR List"
                press="onGoToPRList"
                class="sapUiSmallMarginTop" />

      </VBox>

    </content>
  </Page>
</mvc:View>